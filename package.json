{
  "name": "client-reply-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "vite build",
    "dev": "tsx watch src/api/server.ts",
    "dev:web": "vite",
    "worker": "tsx src/worker/index.ts",
    "api": "tsx src/api/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "audit": "node scripts/audit.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.2.0",
    "googleapis": "^185.0.0",
    "mailparser": "^3.9.37",
    "mongodb": "^7.7.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

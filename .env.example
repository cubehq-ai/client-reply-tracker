# Demo fixtures. Off by default: a real deployment must never show invented
# mailboxes, clients or mail. Tests set this to true.
FIXTURES_ENABLED=false

# ---------- Database ----------
# Postgres connection string. Neon works as-is (sslmode=require).
DATABASE_URL=postgres://localhost:5432/client_reply_tracker

# ---------- Google Workspace (domain-wide delegation) ----------
# Path to the service account JSON key with DWD enabled.
# Leave empty to run against the in-memory fake Gmail/Directory (default for dev).
GOOGLE_SERVICE_ACCOUNT_FILE=
# A Workspace super-admin address to impersonate for Directory API calls.
GOOGLE_ADMIN_SUBJECT=
# Set to "real" to use the live Google APIs, "fake" to use fixtures.
GOOGLE_BACKEND=fake

# ---------- Org configuration ----------
# Our own domains, comma-separated. Mail from these is "internal".
ORG_DOMAINS=cubehq.ai
# Google Group / shared-inbox addresses that also count as internal senders.
# Leave empty unless you actually have one.
GROUP_ADDRESSES=
# Allowlist of mailboxes to watch. Empty = every active Directory user.
WATCHED_MAILBOXES=
# Mailboxes that must never be read, comma-separated (SPEC 11).
EXCLUDED_MAILBOXES=
# Gmail labels that must never be read, comma-separated (SPEC 11).
EXCLUDED_LABELS=
# Initial backfill window in days (SPEC 3.2).
BACKFILL_DAYS=30
# Delete stored body text after this many days; metadata is kept (SPEC 11).
BODY_RETENTION_DAYS=90

# ---------- SLA (SPEC 8) ----------
SLA_DEFAULT_HOURS=24
SLA_TIMEZONE=Asia/Kolkata
SLA_BUSINESS_HOURS_ONLY=true
SLA_BUSINESS_START_HOUR=9
SLA_BUSINESS_END_HOUR=18

# ---------- Pub/Sub (Phase 3) ----------
# projects/<project>/topics/<topic>. Empty = polling only, no watch registration.
PUBSUB_TOPIC=
# Shared secret appended to the push endpoint URL as ?token=
PUBSUB_VERIFICATION_TOKEN=

# ---------- Classifier (Phase 2) ----------
# Empty = heuristics only, no paid calls. Set to use the real Haiku classifier.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
DRAFT_MODEL=claude-sonnet-5-5
# Below this, items still show in Needs Reply but tagged low-confidence (SPEC 5).
NEEDS_REPLY_CONFIDENCE_THRESHOLD=0.6

# ---------- Client dashboard sync (SPEC 10) ----------
# Connection string for the dashboard DB that owns clients + domains.
# Empty = use the fixture client source.
CLIENT_DB_URL=

# ---------- Safety switches (non-negotiable defaults) ----------
# false = never call Gmail send; log the full MIME instead.
SEND_ENABLED=false
# false = never modify labels, read state, or delete anything in Gmail.
GMAIL_WRITE_ENABLED=false

# ---------- Server ----------
PORT=8787
LOG_LEVEL=info
# Dev convenience: trust this address as the signed-in user.
DEV_USER_EMAIL=dev@cubehq.ai

# ---------- Internal tool database (clients + employees) ----------
# READ-ONLY connection string. Every query runs in a READ ONLY transaction;
# grant the login SELECT and nothing else.
INTERNAL_DB_URL=
# Optional SQL overrides, once the real schema is known. Run
# `npx tsx src/cli.ts inspect-internal-db` to print tables and columns.
# Clients query must return: external_id, name [, tier, account_manager_email,
# domains, contacts, website, sla_hours]
INTERNAL_DB_CLIENTS_QUERY=
# Employees query must return: email [, name, team, manager_email]
INTERNAL_DB_EMPLOYEES_QUERY=

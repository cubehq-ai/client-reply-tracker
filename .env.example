# ReplyQueue configuration.
#
# Only what the app actually reads. Anything not listed here is not consulted;
# if you find a variable set in a deployment that is not in this file, it does
# nothing and can be deleted.

# ---- required ----
# Postgres for this tool's own data. No default: a deployed service without it
# used to fall back to localhost and crash-loop on a refused connection.
DATABASE_URL=
# Domains that count as "us". Everything else is a client or an outsider.
ORG_DOMAINS=cubehq.ai

# ---- Google ----
# "real" takes effect only when a key file is also configured.
GOOGLE_BACKEND=fake
GOOGLE_SERVICE_ACCOUNT_FILE=
# Or the key itself, for a container with nowhere to keep a file. Paste the
# whole JSON on one line. The file wins if both are set.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Scopes must match the domain-wide delegation entry EXACTLY. Delegation
# rejects the whole token request if any requested scope is unauthorised, so
# asking for more than you were granted breaks every mailbox at once.
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.send
GOOGLE_DIRECTORY_SCOPES=https://www.googleapis.com/auth/admin.directory.user.readonly
# An admin to impersonate for the Directory API. Without it, nightly mailbox
# discovery skips; mailboxes are managed in Settings regardless.
GOOGLE_ADMIN_SUBJECT=

# ---- safety ----
# Both default to off. Sending logs the message instead of delivering it.
SEND_ENABLED=false
GMAIL_WRITE_ENABLED=false
SLACK_SEND_ENABLED=false

# ---- Slack ----
# A user token (xoxp-), not a bot token. Empty disables Slack entirely: no
# sync, no network calls, and the tab reads "not connected".
SLACK_USER_TOKEN=
# Minutes a channel must be quiet before ambiguous groups go to the model.
SLACK_DEBOUNCE_MINUTES=15
# How long an ANSWERED Slack message is kept before the nightly sweep deletes
# it. Deleted rather than emptied: in a channel the metadata IS the message.
# Nothing still waiting on us is ever deleted, nor anything posted after it,
# nor a thread holding one. Defaults to BACKFILL_DAYS, so the sweep drops
# exactly what a fresh backfill would not have fetched.
SLACK_RETENTION_DAYS=30
# Messages kept per channel whatever their age, so the conversation view has
# its context in a channel that has been quiet for months. The view shows 50.
SLACK_KEEP_MESSAGES=100

# ---- the internal dashboard (READ ONLY) ----
# Source of truth for clients and employees, owned by another team. Never
# written to. Lives in .env.internal, which is not readable by the agent.
INTERNAL_MONGO_URL=
INTERNAL_MONGO_DB=

# ---- classifier ----
# Empty means rules only: no model calls, and Slack's ambiguous case keeps its
# guess with low_confidence set rather than asking a model.
ANTHROPIC_API_KEY=
# Model ids are configuration because they are deprecated and replaced on
# Anthropic's schedule, not ours — a new id should not need a code change.
CLASSIFIER_MODEL=claude-haiku-5-5
DRAFT_MODEL=claude-sonnet-5-5
NEEDS_REPLY_CONFIDENCE_THRESHOLD=0.6

# ---- windows and retention ----
BACKFILL_DAYS=30
BODY_RETENTION_DAYS=90
# How long a closed item stays on the "No reply needed" tab.
CLOSED_VISIBLE_DAYS=14
# Hours before an unanswered message counts as waiting. Also the default the
# inbox's waiting filter opens on.
UNRESPONDED_AFTER_HOURS=12

# ---- SLA (drives overdue alerts only; nothing in the UI shows it) ----
SLA_TIMEZONE=Asia/Kolkata
SLA_DEFAULT_HOURS=24
SLA_BUSINESS_HOURS_ONLY=true
SLA_BUSINESS_START_HOUR=9
SLA_BUSINESS_END_HOUR=18

# ---- optional ----
# Restricts the watch list; empty means every active mailbox.
WATCHED_MAILBOXES=
# Shared inboxes and groups: internal senders, not clients.
GROUP_ADDRESSES=
# Exclusions. The Settings UI writes to the database instead; these are for
# setting a floor at deploy time.
EXCLUDED_MAILBOXES=
EXCLUDED_LABELS=
# Push notifications. Unset means polling only, so mail arrives on the
# 10-minute sync rather than in seconds.
PUBSUB_TOPIC=
PUBSUB_VERIFICATION_TOKEN=
# Resolvers to fall back on when this machine cannot resolve the database
# host. Some networks answer every other name but refuse that one.
DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8
PORT=8787
LOG_LEVEL=info

# Credentials for systems this tool only READS.
#
# This file is denied to Claude's Read tool in .claude/settings.json, so the
# agent can run the app against it but never see the credential itself.
# Copy to .env.internal and fill in. .env.internal is gitignored.
#
# MUST be a SELECT-only login. The app verifies this at runtime and refuses to
# query if the role can write — see docs/STATUS.md "Internal database safety".
INTERNAL_DB_URL=

# Optional SQL overrides once the real schema is known.
INTERNAL_DB_CLIENTS_QUERY=
INTERNAL_DB_EMPLOYEES_QUERY=

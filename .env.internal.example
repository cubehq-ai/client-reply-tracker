# Credentials for systems this tool only READS.
#
# This file is denied to Claude's Read tool in .claude/settings.json, so the
# agent can run the app against it but never see the credential itself.
# Copy to .env.internal and fill in. .env.internal is gitignored.
#
# Should be a READ-ONLY login. The app only ever issues read operations — the
# driver wrapper in src/sync/internalMongo.ts exposes no write method at all —
# and it checks the credential's roles at startup, warning if it can write.
INTERNAL_MONGO_URL=
INTERNAL_MONGO_DB=
